# Heltec V4 running MeshCore "Companion Radio (WiFi)" firmware
MESHCORE_HOST=192.168.1.50
MESHCORE_PORT=5000
MESHCORE_MAX_CHANNELS=8

# MQTT broker (use the service/container name if on the same Docker network)
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
MQTT_CLIENT_ID=meshcore2mqtt
MQTT_PREFIX=meshcore

# Airtime protection
TX_MIN_INTERVAL=3
TX_MAX_BYTES=140
TX_MAX_PARTS=3
TX_MAX_AGE=120
TX_QUEUE_SIZE=20

RECONNECT_DELAY=10
LOG_LEVEL=INFO
DM_MAX_ATTEMPTS=3
